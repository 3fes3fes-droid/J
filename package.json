{
  "name": "jujutsu-manga-db",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "normalize:data": "node scripts/build-entity-image-evidence.mjs && node scripts/normalize-db.mjs",
    "evidence:comics": "node scripts/build-comic-evidence.mjs",
    "evidence:entities": "node scripts/build-entity-image-evidence.mjs",
    "prebuild": "node scripts/build-entity-image-evidence.mjs && node scripts/normalize-db.mjs",
    "dev": "vite --config vite.pages.config.ts",
    "build": "vite build --config vite.pages.config.ts",
    "start": "vite preview --config vite.pages.config.ts",
    "test": "npm run typecheck:pages && npm run build && npm run test:data && node --test tests/pages.test.mjs",
    "validate:artifact": "bash scripts/validate-artifact.sh",
    "lint": "bash scripts/sites-env.sh -- eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern reference-original",
    "db:generate": "bash scripts/sites-env.sh -- drizzle-kit generate",
    "test:data": "node --test tests/data-integrity.test.mjs",
    "verify:migration": "node scripts/verify-migration.mjs",
    "build:legacy": "bash scripts/build-verified.sh",
    "test:legacy": "npm run build:legacy && node --test tests/data-integrity.test.mjs tests/original-page-storage.test.mjs tests/rendered-html.test.mjs",
    "dev:pages": "vite --config vite.pages.config.ts",
    "preview:pages": "vite preview --config vite.pages.config.ts",
    "typecheck:pages": "tsc --project tsconfig.pages.json",
    "dev:legacy": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vite",
    "start:legacy": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.28.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "呪術廻戦データベース"
}
